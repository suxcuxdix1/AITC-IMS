rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isLogistics() {
      return hasRole('Logistics') || isAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidEquipment(data) {
      return data.sku is string && data.sku.size() <= 64 &&
             data.name is string && data.name.size() <= 128 &&
             data.stockLevel is int &&
             data.category in ['Ballistic Vest', 'Vehicle Plating', 'Tactical Helmet', 'Shield', 'Other'] &&
             (!('unitPrice' in data) || data.unitPrice is number) &&
             (!('reorderPoint' in data) || data.reorderPoint is int);
    }

    function isValidTransaction(data) {
      return data.type in ['IN', 'OUT'] &&
             data.quantity is int && data.quantity > 0 &&
             data.equipmentId is string &&
             data.userId == request.auth.uid &&
             data.timestamp == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && 
                       incoming().role in ['Admin', 'Logistics'] &&
                       incoming().email == request.auth.token.email;
      allow update: if isSignedIn() && request.auth.uid == userId && 
                       incoming().role == existing().role && // Prevent self-elevation
                       incoming().diff(existing()).affectedKeys().hasOnly(['name']);
    }

    match /equipment/{itemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidEquipment(incoming());
      allow update: if (isAdmin() && isValidEquipment(incoming())) ||
                       (isLogistics() && 
                        incoming().diff(existing()).affectedKeys().hasOnly(['stockLevel']) &&
                        incoming().stockLevel >= 0);
      allow delete: if isAdmin();
    }

    match /warehouses/{warehouseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isLogistics() && isValidTransaction(incoming()) &&
                       exists(/databases/$(database)/documents/equipment/$(incoming().equipmentId));
      // Transactions are immutable audit logs
      allow update, delete: if false;
    }
  }
}
